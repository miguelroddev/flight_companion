# Copy this file to .env for local development.
# .env is gitignored — never commit real credentials.

POSTGRES_USER=flight
POSTGRES_PASSWORD=flight_dev_password
POSTGRES_DB=flight_companion

# Must match the values above; postgresql+psycopg tells SQLAlchemy to use
# the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://flight:flight_dev_password@db:5432/flight_companion
